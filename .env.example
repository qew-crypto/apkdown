# Token from your own @BotFather bot. Personal-account access below is optional.
BOT_TOKEN=replace_with_your_bot_token

# OPTIONAL: all three empty = ordinary Bot API mode only.
# API_ID / API_HASH: https://my.telegram.org -> API development tools.
API_ID=
API_HASH=
# Your personal numeric Telegram user ID, not the bot ID.
ACCOUNT_OWNER_ID=
# Log in via /account_login in your own bot private chat.
# Never put phone, login code or 2FA password in this file.
